        1,                        // Priority of the task
        &TaskpublishDependum_eventoDeIdentificación_MessageSender        // Task handle
    );

    // Start the threads
    vTaskStartScheduler();
}



void publishDependum_eventoDeIdentificación_MessageSenderTask(void *pvParameters) {

    //
    // --- Comm Thread Information ---
    // Name: Evento de identificación - message sender
    // ID: cim-d1-comm_thread
    // Description: This Comm Thread is responsible for generating the dependum: eventoDeIdentificación_MessageSender_data_structure
    //
    // Original Element in PIM: Evento de identificación - message sender
    // Transformed To: Function `eventoDeIdentificación_MessageSender()`
    //
    // Note for Developers:
    // The `dependum` data should be generated by the function publicarEventoDeIdentificación().
    // Ensure the function completes its operation and provides the required data 
    // in the appropriate format for transmission.
    // 
    // Qualification Array:
    //  * None specified.
    // 
    // Contribution Array:
    //  * None specified.
    // 
    //
    // This variable handles the period in milliseconds for thread execution
    const TickType_t xDelay = pdMS_TO_TICKS(500);
    for (;;) {
        // Create a JSON object for the dependum
        JSONVar dependumJson;
        dependumJson["timestamp"] = eventoDeIdentificación_MessageSender_data_structure.timestamp;
        dependumJson["person_id"] = eventoDeIdentificación_MessageSender_data_structure.person_id;
        dependumJson["person_name"] = eventoDeIdentificación_MessageSender_data_structure.person_name;
        dependumJson["confidence"] = eventoDeIdentificación_MessageSender_data_structure.confidence;
        dependumJson["authorized"] = eventoDeIdentificación_MessageSender_data_structure.authorized;

        // Convert the JSON object to a string
        String dependumMessage = JSON.stringify(dependumJson);



        eventoDeIdentificación_MessageSenderMqttClient.publish(eventoDeIdentificación_MessageSender_topic, dependumMessage.c_str());  // Publish message
        if (debug) {
            Serial.println("Dependum published successfully for Evento de identificación - message sender!");
            Serial.print("Topic: ");
            Serial.println(eventoDeIdentificación_MessageSender_topic);
            Serial.print("Message: ");
            Serial.println(dependumMessage);
        } else {
            if (debug) {
                Serial.println("Failed to publish dependum for Evento de identificación - message sender.");
            }
            
        }
        vTaskDelay(xDelay);
    }
}




